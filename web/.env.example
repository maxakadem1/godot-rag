# Copy to .env.local. All server-side: never prefix these with NEXT_PUBLIC_.

# The Python API (local: http://localhost:8000, deployed: your API's Vercel URL).
RAG_API_URL=http://localhost:8000
# Same value as the API's INTERNAL_API_KEY. Leave empty if the API has none (local).
INTERNAL_API_KEY=

# Shared password that unlocks LLM answers, and the secret that signs unlock cookies.
# Changing either logs everyone out. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_PASSWORD=
SESSION_SECRET=

# Upstash Redis for limits shared across serverless instances. Vercel's Upstash
# integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either works.
# Without them, limits are kept in memory (fine for local development).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Questions per minute per IP, and LLM answers per UTC day across everyone.
RATE_LIMIT_PER_MINUTE=20
DAILY_ANSWER_LIMIT=200
