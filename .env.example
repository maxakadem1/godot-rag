# Copy to .env and fill in. Never commit .env.

# OpenAI: used for both embeddings and answers (platform.openai.com, billed per use)
OPENAI_API_KEY=sk-...

# Pinecone: vector storage (app.pinecone.io). The index is created on first use.
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=godot-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Models
EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model (text-embedding-3-small = 1536, -large = 3072).
# The Pinecone index is created with this dimension; changing it means a new index.
EMBEDDING_DIMENSIONS=1536
# Check OpenAI's models page for their current small chat model.
CHAT_MODEL=gpt-4o-mini

# Source data
GODOT_DOCS_REPO=https://github.com/godotengine/godot-docs.git
GODOT_DOCS_BRANCH=stable
DOCS_BASE_URL=https://docs.godotengine.org/en/stable
DATA_DIR=data

# Retrieval
TOP_K=5

# API protection (see README "Deploying"). Leave INTERNAL_API_KEY empty locally.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
# 0 turns a limit off.
RATE_LIMIT_PER_MINUTE=30
DAILY_ANSWER_LIMIT=300
